# Production settings. Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The domain this server answers on (DNS A record -> the instance's Elastic IP).
DOMAIN=music.example.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and invalidates Subsonic app passwords.
SECRET_KEY=

# Host folders (on the EBS data volume) mounted into the app container.
DATA_DIR=/srv/angelstream/data
MUSIC_DIR=/srv/angelstream/music

# The first admin is created with: docker compose exec app python -m app.manage create-user <name> --admin
# After that, true lets anyone sign up as a listener; false means admins add users.
ALLOW_REGISTRATION=false

# Token lifetimes (seconds): access 1 hour, refresh 60 days (sliding), stream URLs 6 hours.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=5184000
STREAM_TOKEN_TTL=21600

# Mobile apps older than this are asked to update (GET /api/config).
MIN_APP_VERSION=1.0.0

MAX_UPLOAD_MB=2048
# Refuse new uploads when free disk space would drop below this.
MIN_FREE_MB=2048

# Only for a web frontend on another origin. Native mobile apps don't need CORS.
CORS_ORIGINS=

# Optional: nightly database backups are copied here (needs the instance's IAM role).
BACKUP_S3_URI=
