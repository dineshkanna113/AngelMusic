# Copy to .env and fill in. Never commit .env.
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Folder containing your music (scanned recursively). Relative paths are from this folder.
AUDIO_DIR=../audio-library
DATABASE_PATH=data/app.db
# Built frontend to serve from the same origin (npm run build in the frontend repo).
FRONTEND_DIST=../lossless-stream-frontend/dist
# Only needed if the frontend is served from a different origin.
CORS_ORIGINS=http://localhost:5173
# The first account is always allowed and becomes admin. Set false to close sign-ups after that.
ALLOW_REGISTRATION=false
ACCESS_TOKEN_TTL=604800
STREAM_TOKEN_TTL=21600
MAX_UPLOAD_MB=2048
